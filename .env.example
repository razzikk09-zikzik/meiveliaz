# Frontend environment — copy to .env and adjust.
# Only VITE_* variables are exposed to the browser. Never put service keys here
# except the optional Gemini fallback below (it becomes public in the bundle).
VITE_API_URL=http://localhost:8000

# Optional: direct Gemini fallback when the backend is unreachable (Render cold
# start). The key WILL be visible in the page source — prototype use only.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.5-flash-lite
