# MEYVIZHI backend configuration — copy to backend/.env and fill in values.
# NEVER commit backend/.env. All values below are placeholders only.

# --- Gemini (AI signal) — optional ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- VirusTotal (URL reputation) — optional ---
# Get a free key at https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# --- Neo4j (graph intelligence) — optional ---
# Create a free AuraDB instance at https://neo4j.com/cloud/aura/
# Use the connection URI shown in the console (neo4j+s://...databases.neo4j.io)
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# --- Supabase (storage + analyst auth) — optional ---
# Create a project at https://supabase.com/dashboard
# Project Settings -> API: copy the Project URL, anon key and service_role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Comma-separated allowed origins. Add your Vercel domain when you deploy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=30
